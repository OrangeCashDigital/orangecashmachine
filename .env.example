# ==============================================================================
# OrangeCashMachine — Variables de entorno
# ==============================================================================
# Uso:
#   cp .env.example .env
#   Editar .env con valores reales antes de levantar Docker.
#
# ⚠️  NUNCA commitear .env al repositorio.
# ==============================================================================

# ── Exchanges ─────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_HOST_PORT=6379
REDIS_MAX_MEMORY=256mb

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_HOST_PORT=3000

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_HOST_PORT=9090

# ── Alertmanager ──────────────────────────────────────────────────────────────
ALERTMANAGER_HOST_PORT=9093

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=8080
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=changeme
KAFKA_LOG_RETENTION_HOURS=168

# Activa el path Kappa (publisher OHLCV → ohlcv.raw). OBLIGATORIA en
# producción: la regla L5 PRODUCTION_REQUIRES_KAFKA_PUBLISHER (F-031) aborta
# el startup en config-load si environment=production con kafka.enabled=false.
KAFKA_ENABLED=true

# Config fina del producer (opcional -- defaults razonables en codigo si se omiten)
# KAFKA_ACKS=all
# KAFKA_LINGER_MS=5
# KAFKA_MAX_BATCH_SIZE=16384
# KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
# KAFKA_CONSUMER_HEARTBEAT_MS=10000
# KAFKA_AUTO_OFFSET_RESET=earliest

# ALERTMANAGER_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=

# ── Pushgateway ───────────────────────────────────────────────────────────────
PUSHGATEWAY_HOST_PORT=9091

# ── Storage ───────────────────────────────────────────────────────────────────
OCM_STORAGE__DATA_LAKE__PATH=/app/data_platform/data_lake

# ── General ───────────────────────────────────────────────────────────────────
OCM_ENV=production
LOG_LEVEL=info
# OCM_DEBUG=false
# OCM_CONFIG_PATH=
# OCM_CONFIG_DIR=
# OCM_VALIDATE_ONLY=false
# PUSHGATEWAY_URL=

# ── Puertos de servicios internos (Docker) ─────────────────────────────────────
# MARKET_DATA_HOST_PORT=8001
# TRADING_HOST_PORT=8002
# PORTFOLIO_HOST_PORT=8003
# LOKI_HOST_PORT=3100

# ── Market data / ingesta ──────────────────────────────────────────────────────
# OCM_EXCHANGE=
# OCM_MARKET_TYPE=
# OCM_OHLCV_START_DATE=
# INGESTION_INTERVAL_S=60
# OCM_HOST_DATA_LAKE_PATH=

# ── Gold layer (opcional segun pipeline usado) ─────────────────────────────────
# OCM_GOLD_PATH=
# OCM_GOLD_FEATURES_PATH=

# ── API Gateway ───────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
OCM_API_JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32
# OCM_API_JWT_EXPIRE_MINUTES=60
# OCM_API_RATE_LIMIT_RPM=60

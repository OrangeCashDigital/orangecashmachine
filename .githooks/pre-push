#!/bin/bash
set -e
PROTECTED_RE='^(opencode\.json|AGENTS\.md|CONTRIBUTING\.md|\.githooks/.*|\.github/.*)$'
ZERO=0000000000000000000000000000000000000000
BLOCKED=0
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$ZERO" ] && continue
  for c in $(git rev-list "$local_sha" --not --remotes=origin); do
    HIT=$(git diff-tree --root --cc --no-commit-id --name-only -r -z "$c" | grep -zaE "$PROTECTED_RE" | tr '\0' ' ' || true)
    if [ -n "$HIT" ]; then
      echo "🔒 BLOQUEADO: commit $c modifica: $HIT"
      BLOCKED=1
    fi
  done
done
if [ "$BLOCKED" = "1" ]; then
  if [ "${GIT_HUMAN_OVERRIDE:-0}" = "1" ]; then
    echo "✅ GIT_HUMAN_OVERRIDE=1 detectado. Permitido."
    exit 0
  fi
  echo "Para autorizar (solo humano): GIT_HUMAN_OVERRIDE=1 git push ..."
  exit 1
fi

#!/bin/bash
set -e
PROTECTED_RE='^(opencode\.json|AGENTS\.md|CONTRIBUTING\.md|\.githooks/.*|\.github/.*)$'
ZERO=0000000000000000000000000000000000000000
BLOCKED=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    COMMITS=$(git rev-list "$local_sha" --not --remotes=origin)
  else
    COMMITS=$(git rev-list "$remote_sha..$local_sha")
  fi
  for c in $COMMITS; do
    HIT=$(git diff-tree -m --no-commit-id --name-only -r "$c" | grep -E "$PROTECTED_RE" || true)
    if [ -n "$HIT" ]; then
      echo "🔒 BLOQUEADO: commit $c modifica: $HIT"
      BLOCKED=1
    fi
  done
done
if [ "$BLOCKED" = "1" ]; then
  if [ "${GIT_HUMAN_OVERRIDE:-0}" = "1" ]; then
    echo "✅ GIT_HUMAN_OVERRIDE=1 detectado. Permitido."
    exit 0
  fi
  echo "Para autorizar (solo humano): GIT_HUMAN_OVERRIDE=1 git push ..."
  exit 1
fi

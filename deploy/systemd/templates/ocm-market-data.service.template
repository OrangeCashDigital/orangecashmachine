[Unit]
Description=OrangeCashMachine market-data-service (REST ingestion + Kappa bronze writer + HTTP :8001)
Documentation=file:${OCM_REPO_ROOT}/docs/architecture/decisions/ADR-0022-lifecycle-proceso-realtime-feeds.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=${OCM_HOST_USER}
WorkingDirectory=${OCM_REPO_ROOT}

# Tolerancia a archivos de entorno opcionales (evita crash loops si falta host.env)
EnvironmentFile=-${OCM_REPO_ROOT}/deploy/host.env
EnvironmentFile=-${OCM_REPO_ROOT}/.env

# Execution Contract: EP-006 market_data.main = MARKET DATA SERVICE ENTRYPOINT
# (config/execution_registry.yaml; autoridad ADR-0048). systemd = deployment consumer, no SSOT.
ExecStart=${OCM_REPO_ROOT}/.venv/bin/python -m market_data.main

# SafeOps & Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=${OCM_REPO_ROOT}/data_platform ${OCM_REPO_ROOT}/logs
PrivateTmp=true

# -----------------------------------------------------------------
# 1. PERFORMANCE TUNING (REST Ingestion Priority)
# -----------------------------------------------------------------
Nice=-5
LimitNOFILE=65536

# -----------------------------------------------------------------
# 2. RESILIENCE & CIRCUIT BREAKER
# -----------------------------------------------------------------
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300s
StartLimitBurst=5
TimeoutStopSec=30
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
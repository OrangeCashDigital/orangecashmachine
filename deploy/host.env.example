# ==============================================================================
# OrangeCashMachine — Host Environment Configuration (Deployment Template)
# ==============================================================================
# Copiar este archivo a /etc/ocm/host.env en la máquina destino y ajustar
# las variables según el layout del servidor (rutas, usuario, puertos).
#
# ⚠️  NO INCLUIR SECRETOS AQUÍ. Los secretos reales (API keys, passwords)
#     deben permanecer en el archivo .env de la raíz del proyecto.
# ==============================================================================

# Usuario Linux sin privilegios que ejecuta los servicios OCM
OCM_USER=orangemusic

# Ruta absoluta al directorio raíz del repositorio OCM
OCM_REPO_ROOT=/home/orangemusic/trading/orangecashmachine

# Ruta absoluta al entorno virtual de Python (.venv)
OCM_VENV_PATH=/home/orangemusic/trading/orangecashmachine/.venv

# Entorno de ejecución de OCM (production | development | test)
OCM_ENV=production

# Dirección y puerto del broker Kafka para los clientes del host
OCM_KAFKA_BOOTSTRAP=localhost:9093

# Host y puerto de Redis
OCM_REDIS_HOST=localhost
OCM_REDIS_PORT=6379

# Puerto host para el microservicio Market Data HTTP (:8001)
OCM_MARKET_DATA_PORT=8001

# URL de Pushgateway para métricas de pipelines
OCM_PUSHGATEWAY_URL=http://localhost:9091

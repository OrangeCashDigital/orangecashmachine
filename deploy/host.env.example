# ==============================================================================
# OrangeCashMachine — plantilla de configuración de host (sin secretos)
# ==============================================================================
# Copiar a deploy/host.env y ajustar valores reales del host.
# Renderizado por deploy/scripts/install_systemd.sh hacia /etc/ocm/*.env.
# NUNCA commitear deploy/host.env (contiene topología local).
# ==============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
OCM_ENV=development
OCM_HOST_USER=orangemusic
OCM_REPO_ROOT=/home/orangemusic/trading/orangecashmachine

# ── Market Data HTTP service ──────────────────────────────────────────────────
MARKET_DATA_HOST=0.0.0.0
MARKET_DATA_PORT=8001
INGESTION_INTERVAL_S=300

# ── Kafka (broker docker en host) ─────────────────────────────────────────────
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

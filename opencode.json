{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git *": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "*.env*": "deny",
      "git fetch*": "allow",
      "git switch*": "allow",
      "git pull --ff-only*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git add -A*": "ask",
      "git add .*": "ask",
      "git commit*": "allow",
      "git commit --amend*": "ask",
      "git push*": "ask",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "git reset*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --delete*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch --delete*": "deny",
      "git clean*": "deny",
      "*--no-verify*": "deny",
      "gh pr merge*": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "ocm-context-bootstrap": "allow"
    }
  }
}

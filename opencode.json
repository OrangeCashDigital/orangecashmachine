{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git *": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "git fetch*": "allow",
      "git switch*": "allow",
      "git pull --ff-only*": "allow",
      "git branch --show-current*": "allow",
      "git branch -a*": "allow",
      "git branch -vv*": "allow",
      "git branch --list*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "git push*": "ask",
      "git commit*--amend*": "ask",
      "gh pr create*": "ask",
      "git reset*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git clean*": "deny",
      "gh pr merge*": "deny",
      "git add .": "deny",
      "git add . *": "deny",
      "git add* -A*": "deny",
      "git add*--all*": "deny",
      "git add* -f*": "deny",
      "git add*--force*": "deny",
      "git commit* -n*": "deny",
      "git push*--force*": "deny",
      "git push* -f*": "deny",
      "git push*--delete*": "deny",
      "git push* -d*": "deny",
      "git push* +*": "deny",
      "git push* :*": "deny",
      "git switch*--discard-changes*": "deny",
      "git switch* -f*": "deny",
      "git switch*--force*": "deny",
      "git switch* -C*": "deny",
      "git branch* -d*": "deny",
      "git branch* -D*": "deny",
      "git branch*--delete*": "deny",
      "git branch* -f*": "deny",
      "git branch*--force*": "deny",
      "*--no-verify*": "deny",
      "*.env*": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "ocm-context-bootstrap": "allow"
    }
  }
}

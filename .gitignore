#   .opencode/agents/
#   .opencode/commands/
#   .opencode/skills/
#   .opencode/plugins/
# Runtime generado por OpenCode / plugins (NO versionar):
.opencode/node_modules/
.opencode/plans/
.opencode/.gitignore
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

AUDITORIA_IMPORT_LINTER.txt
docs/arch/import_graph_*.svg
*.pyc
*.bak

# Gobernanza automatizada — artefactos generados, nunca versionables

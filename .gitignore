# Byte-compiled / Python files
__pycache__/
*.py[cod]
*$py.class

# Logs y bases de datos locales
*.log
*.sqlite
*.db
# Configs sensibles
config.json
.env
secrets.yaml
# Archivos del sistema
.DS_Store
Thumbs.db
# Archivos temporales
*.tmp
*.swp
data_platform/data_lake/
.envrc
# Lakehouse local de desarrollo (path resuelto por settings.yaml / LOCAL_DATA_LAKE_PATH)
data_platform/local_data_lake/
logs/
*.bak

# El log de verificación de ADRs (reubicado desde docs/architecture/0006)
# SÍ es versionable — excepción al patrón logs/ de arriba.
!docs/architecture/logs/
!docs/architecture/logs/**

# ==============================================================================
# Iceberg runtime — artefactos generados, nunca versionables
# ==============================================================================
# iceberg_catalog/ : SQLite catalog (catalog.db + lock files)
# iceberg_warehouse/: archivos Parquet de datos reales
# Estos viven dentro de data_platform/ (sibling del data_lake).
# SSOT: paths.py los coloca en data_lake_root().parent / "iceberg_*"
data_platform/iceberg_catalog/
data_platform/iceberg_warehouse/

# Archivos temporales de SQLite (journal, WAL)
*.db-journal
*.db-wal
*.db-shm
data/lineage/*.db
data/quality/*.db
.coverage
.import_linter_cache/
.opencode/
AUDITORIA_IMPORT_LINTER.txt
docs/arch/import_graph_*.svg
*.pyc
*.bak

# Gobernanza automatizada — artefactos generados, nunca versionables
# metrics_report.py escribe el informe; se sube como artifact en CI.
architecture/metrics.json
# shared.svg es el grafo generado por pydeps (artifact opcional, no se commitea).
shared.svg
coverage.json

# Artefactos de corridas/experimentos locales (pids, logs de canary, dumps)
# Salidas de verificación empírica — evidencia viva, no versionable.
# SI la evidencia debe persistirse, ir a un doc en docs/audits/ (como f26c).
artifacts/
